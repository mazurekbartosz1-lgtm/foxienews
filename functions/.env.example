# Non-secret environment configuration for Firebase Functions (functions/.env)
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-obsidian-vault-repo
GITHUB_BRANCH=main
GEMINI_MODEL=gemini-2.5-flash

# Secrets managed via Firebase Secret Manager (for local emulator testing, put these in functions/.secret.local):
# GITHUB_TOKEN=ghp_...
# GEMINI_API_KEY=AIza...
# DEVICE_API_KEY=change-me-long-random-string
# GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
# ALLOWED_USER_EMAIL=you@example.com
