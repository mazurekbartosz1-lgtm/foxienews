rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "REPLACE_WITH_ALLOWED_USER_EMAIL";
    }

    // Cached wiki pages synced from GitHub via Cloud Functions (Admin SDK only writes)
    match /wiki_pages/{slug} {
      allow read: if isAllowedUser();
      allow write: if false;
    }

    // Wiki metadata & table of contents (e.g. wiki_meta/index)
    match /wiki_meta/{docId} {
      allow read: if isAllowedUser();
      allow write: if false;
    }

    // Extracted tasks (- [ ] / - [x]) synced from vault
    match /tasks/{taskId} {
      allow read: if isAllowedUser();
      allow write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
